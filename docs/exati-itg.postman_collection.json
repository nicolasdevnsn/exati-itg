            "description": "Authenticate with username + password and obtain a fresh JWT. Issued tokens remain valid until they expire — there is no server-side revocation.\n\n**Status codes**\n- `200 OK` — token in response body\n- `401 Unauthorized` — bad credentials or unknown user\n- `400 Bad Request` — missing fields\n\n**Test script** stores `accessToken` into the collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('accessToken returned', () => pm.expect(body.accessToken).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('accessToken', body.accessToken);",
                  "console.log('Saved accessToken (expires ' + body.expiresAt + ')');"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"tokenType\": \"Bearer\",\n  \"accessToken\": \"eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJhbGljZSIsImlhdCI6MTcxOTc0NDAwMCwiZXhwIjoxNzE5NzQ3NjAwfQ.signature\",\n  \"expiresAt\": \"2026-06-30T14:00:00Z\",\n  \"username\": \"alice\"\n}"
            },
            {
              "name": "401 Unauthorized",
              "status": "Unauthorized",
              "code": 401,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/problem+json"
                }
              ],
              "body": "{\n  \"type\": \"about:blank\",\n  \"title\": \"Unauthorized\",\n  \"status\": 401,\n  \"detail\": \"Invalid credentials.\",\n  \"timestamp\": \"2026-06-30T13:00:00Z\"\n}"
            }
          ]
        }
      ]
    },
