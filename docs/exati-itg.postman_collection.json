    {
      "name": "TALQ (Tier 2)",
      "description": "TALQ Tier 2 resource endpoints. JWT-protected edges that forward to the Exati IoT Hub `/talq/*` API. Payloads are **arrays**. Tier 2 errors come back from Exati as an array of `TalqErrorMessage` (`key`/`description`), which this API maps to RFC 7807 problem responses.",
      "item": [
        {
          "name": "Create Device Class",
          "request": {
            "method": "POST",
